{% extends 'base.html.twig' %}

{% block title %}Editor index{% endblock %}

{% block main %}
    <h1>Editor index</h1>

    <p>Il y a {{ countEditor }} éditeurs.</p>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Address</th>
                <th>Pc</th>
                <th>City</th>
                <th>Phone</th>
                <th>Nombre de jeux</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for editor in editors %}
            <tr>
                <td>{{ editor.id }}</td>
                <td>{{ editor.name }}</td>
                <td>{{ editor.address }}</td>
                <td>{{ editor.pc }}</td>
                <td>{{ editor.city }}</td>
                <td>{{ editor.phone|formatPhone }}</td>
                <td>{{ editor.games|length }}</td>
                <td>
                    <a href="{{ path('app_editor_show', {'id': editor.id}) }}">show</a>
                    <a href="{{ path('app_editor_edit', {'id': editor.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_editor_new') }}">Create new</a>
{% endblock %}
