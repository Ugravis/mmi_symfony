<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        {% block stylesheets %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body>
        {% block nav %}
            <nav>
                <ul>
                    <li><strong>MMIPLE</strong></li>
                </ul>
                <ul>
                    <li><a href="{{ path('app_home') }}">{{ 'Accueil'|trans }}</a></li>
                    <li><a href="{{ path('app_games') }}">{{ 'Jeux'|trans }}</a></li>
                    <li><a href="{{ path('app_editor_index') }}">{{ 'Editeurs'|trans }}</a></li>
                    <li><a href="{{ path('app_contact') }}">{{ 'Contact'|trans }}</a></li>
                    <li><a href="{{ path('app_about') }}">{{ 'A Propos'|trans }}</a></li>
                    <li><a href="{{ path('app_cart') }}">{{ 'Panier'|trans }}</a></li>

                    <li><a href="{{ path('app_games', { _locale: 'fr' }) }}">FR</a></li>
                    <li><a href="{{ path('app_games', { _locale: 'en' }) }}">EN</a></li>
                </ul>
            </nav>
        {% endblock %}
        
        {% block main %}
        {% endblock %}
        
        {%  block footer %}
            <footer style="position: absolute; bottom: 0;">@Designed By MMI</footer>
        {% endblock %}
    </body>
</html>