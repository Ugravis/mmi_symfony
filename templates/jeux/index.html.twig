{% extends 'base.html.twig' %}

{% block title %} Liste des Jeux {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        th {
            background-color: #000;
            color: #fff;
        }
        .image-vignette {
            width: 150px;
            height: 100px;
        }
    </style>
{%  endblock %}

{% block main %}
    <table>
        <tr>
            <th>id</th>
            <th>Jeu</th>
            <th>Image</th>
            <th>Prix</th>
        </tr>
        {% for game in games %}
            <tr>
                <td><a href="{{ path('app_fiche', { 'id': game.id }) }}">{{ game.id }}</a></td>
                <td>{{ game.name }}</td>
                <td><img class="image-vignette" src="{{ asset('images/jeux/') }}{{ game.photo1 }}" alt="{{ game.name }}" /></td>
                <td>{{ game.price }}</td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}