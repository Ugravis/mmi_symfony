{% extends 'base.html.twig' %}

{% block title %} Liste des Jeux {% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        th {
            background-color: #000;
            color: #fff;
        }
        .image-vignette {
            width: 150px;
            height: 100px;
        }
    </style>
{%  endblock %}

{% block main %}
    <a href="{{ path('app_game_new') }}">Ajouter un jeu</a>

    <table>
        <tr>
            <th>id</th>
            <th>Jeu</th>
            <th>Image</th>
            <th>Prix</th>
            <th>Avis</th>
            <th>Editeur</th>
            <th>Actions</th>
        </tr>
        {% for game in games %}
            <tr>
                <td><a href="{{ path('app_fiche', { 'id': game.id }) }}">{{ game.id }}</a></td>
                <td>{{ game.name }}</td>
                <td><img class="image-vignette" src="{{ asset('images/jeux/') }}{{ game.photo1 }}" alt="{{ game.name }}" /></td>
                <td>{{ game.price|price('€', 2, ',', ' ') }}</td>
                <td>{{ 3|stars }}</td>
                <td>{{ game.editor != null ? game.editor.name : "Non précisé" }}</td>
                <td>
                    <a 
                        href="{{ path('app_game_edit', { id: game.id }) }}"
                    >
                        Modifier
                    </a>

                    <button
                        class="btn btn-primary ajoutJeu" 
                        data-id="{{ game.id }}" 
                        data-name="{{ game.name }}" 
                        data-price="{{ game.price }}"
                    >
                        Ajouter au panier
                    </button>
                </td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}