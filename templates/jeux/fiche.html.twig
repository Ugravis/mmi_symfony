{% extends 'base.html.twig' %}

{% block title %}Fiche Jeu{% endblock %}
    
{% block stylesheets %}
    {{ parent() }}
    <style>
        .image-jeu {
            width: 200px;
            height: 150px;
        }
    </style>
{%  endblock %}
    
{% block main %}
    <a href="{{ path('app_games') }}">Retour à la liste des jeux</a><br></br>
    <h1>{{ game.name }}</h1>
    <h4>{{ game.editor ? 'Par ' ~ game.editor.name : 'Éditeur inconnu' }}</h4>
    <h4>{{ game.price }} €</h4>

    <img src="{{ asset('images/jeux/') }}{{ game.photo1 }}" alt="{{ game.name }}" class="image-jeu" />
    <img src="{{ asset('images/jeux/') }}{{ game.photo2 }}" alt="{{ game.name }}" class="image-jeu" />
    <img src="{{ asset('images/jeux/') }}{{ game.photo3 }}" alt="{{ game.name }}" class="image-jeu" />

    <p>Entre <b>{{ game.mini }}</b> et <b>{{ game.max }}</b> joueurs. Durée d'une partie : <b>{{ game.duration }} minutes.</p>
    <p>En stock (<b>{{ game.stock }}</b> disponibles).</p>

    <form method="post" action="{{ path('app_game_delete', {'id': game.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
            <button class="btn btn-danger">Supprimer</button>
        </form>
{% endblock %}